[
  {
    "date": "2026-08-13",
    "category": "대인관계력",
    "text": "새로 만난 사람에게 먼저 가볍게 말을 걸며 자연스럽게 소통했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-14",
    "category": "대인관계력",
    "text": "이야기를 많이 하는 팀원의 말을 끝까지 듣고 이해하려고 했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-18",
    "category": "대인관계력",
    "text": "새로운 사람에게 먼저 다가가 농담과 대화를 나누며 편하게 소통했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-19",
    "category": "대인관계력",
    "text": "버스에서 낯선 사람의 머리카락에 거미가 있는 것을 보고 먼저 허락을 구한 뒤 도와주었다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-21",
    "category": "대인관계력",
    "text": "낯선 사람이 유리문에 머리를 부딪힌 상황에서 상대가 당황하지 않도록 모른 척 배려했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-25",
    "category": "대인관계력",
    "text": "내가 선호하지 않는 행동을 하는 사람에게도 끝까지 친절하게 대하려고 했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-26",
    "category": "대인관계력",
    "text": "내가 선호하지 않는 사람의 이야기도 끝까지 듣고 도움을 요청하거나 의견을 받아들였다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-27",
    "category": "대인관계력",
    "text": "상대방의 이야기를 끝까지 듣고 사람에게 친절하게 대하는 연습을 이어갔다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-28",
    "category": "대인관계력",
    "text": "평소 선호하지 않는 사람의 호의를 무시하지 않고 다른 면을 바라보려고 했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-03",
    "category": "대인관계력",
    "text": "수업 밖에서 만난 같은 반 사람에게 먼저 인사했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-04",
    "category": "대인관계력",
    "text": "낯선 사람이 지나갈 수 있도록 문을 잡아주며 배려했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-07",
    "category": "대인관계력",
    "text": "주변 사람의 작은 변화를 관찰하고 먼저 알아차리려고 했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-18",
    "category": "대인관계력",
    "text": "상대방의 고민을 들으면서 바로 해결하려 하지 않고 먼저 이야기를 끝까지 들어주었다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-12",
    "category": "자기동기력",
    "text": "다른 사람이 지나칠 수 있는 작은 부분도 직접 살펴보며 스스로 분석했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-08",
    "category": "자기동기력",
    "text": "모르는 문제가 생겼을 때 직접 찾아보고 AI의 도움도 활용해 해결했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-11",
    "category": "자기동기력",
    "text": "궁금한 것이 생기면 그냥 넘기지 않고 직접 해결하려고 했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-15",
    "category": "자기동기력",
    "text": "쉬는 시간과 점심시간에도 개인 프로젝트에 몰입하며 직접 작업을 이어갔다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-16",
    "category": "자기동기력",
    "text": "혼자서는 어렵다고 생각했던 개인 프로젝트를 직접 시작하고 처음 완성했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-17",
    "category": "자기동기력",
    "text": "필요한 정보를 미리 찾아보고 프로젝트를 늦게까지 진행하면서 오류까지 확인했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-10-02",
    "category": "자기동기력",
    "text": "과제에서 워크벤치를 적극적으로 활용하며 주어진 환경에서 최선의 결과를 만들려고 했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-10-06",
    "category": "자기동기력",
    "text": "쉬는 날에도 개인 프로젝트를 보완하고 오류를 찾아보며 작업을 이어갔다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-11",
    "category": "자기조절력",
    "text": "12시간 동안 컴퓨터 앞에 앉아 수업에 집중했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-20",
    "category": "자기조절력",
    "text": "피곤한 상태에서도 잠들기 전에 해야 할 일을 끝까지 마무리했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-24",
    "category": "자기조절력",
    "text": "주말에도 평소 생활 패턴을 유지하며 스스로 한 약속을 지켰다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-08-31",
    "category": "자기조절력",
    "text": "피곤한 상태에서도 해야 할 일을 미루지 않고 끝까지 마무리했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-02",
    "category": "자기조절력",
    "text": "컨디션이 좋지 않은 날에는 쉬면서 회복한 뒤 다음 날 다시 일상으로 돌아왔다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-09",
    "category": "자기조절력",
    "text": "수업 중 잠들지 않기 위해 꾸준히 커피를 챙기며 집중 상태를 유지했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-10",
    "category": "자기조절력",
    "text": "집에 돌아온 뒤 무작정 쉬기보다 나만의 재충전 루틴을 만들어 다음 날을 준비했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-14",
    "category": "자기조절력",
    "text": "주말에도 평소의 생활 흐름을 유지하며 여러 상황을 넓게 바라보려고 했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-21",
    "category": "자기조절력",
    "text": "휴일에도 일찍 자고 일찍 일어나며 평소 생활 흐름이 무너지지 않도록 관리했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-22",
    "category": "자기조절력",
    "text": "아침에 일찍 일어나 맨몸 운동을 하며 하루를 시작했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-28",
    "category": "자기조절력",
    "text": "컨디션이 좋지 않은 상황에서도 필요한 준비를 하고 수업에 참여하며 맡은 일을 이어갔다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-29",
    "category": "자기조절력",
    "text": "컨디션을 관리하기 위해 물을 충분히 마시며 건강을 챙겼다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-09-30",
    "category": "자기조절력",
    "text": "다음 날을 원활하게 보내기 위해 일찍 잠들며 스스로 약속한 하루를 지키려고 했다.",
    "source_type": "ritual"
  },
  {
    "date": "2026-10-01",
    "category": "자기조절력",
    "text": "컨디션 회복에 집중하고 충분히 식사하며 다시 일상으로 돌아갈 준비를 했다.",
    "source_type": "ritual"
  }
]